# Duckyo 多模态检索系统环境变量

# 必须配置
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Milvus 配置 (本地部署)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Collection 名称
MILVUS_COLLECTION=duckyo_travel_memories

# MinIO 配置 (可选)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=duckyo-memories
MINIO_SECURE=false

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# 检索配置
DEFAULT_TOP_K=10
RERANK_TOP_K=100