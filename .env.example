# Duckyo Multimodal Retrieval System Environment Variables

# Required
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Milvus Config (local deployment)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Collection name
MILVUS_COLLECTION=duckyo_travel_memories

# MinIO Config (optional)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=duckyo-memories
MINIO_SECURE=false

# API Config
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval Config
DEFAULT_TOP_K=10
RERANK_TOP_K=100
